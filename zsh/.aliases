# My aliases
# References:
# - https://lift.cs.princeton.edu/java/.bashrc
# - https://github.com/mathiasbynens/dotfiles/blob/main/.aliases
# - and more

# Directories
alias ..="cd .."
alias -- -="cd -"
alias md="mkdir -p"

# Detect which `ls` flavor is in use
if ls --color >/dev/null 2>&1; then # GNU `ls`
  colorflag="--color"
else # macOS `ls`
  colorflag="-G"
fi

# ls
if command -v lsd &>/dev/null; then
  alias ls='lsd -F'
else
  alias ls="ls -F ${colorflag}"
fi
alias ll="ls -lh"
alias la="ls -A"
alias l="ll -A"

# interactive
# alias cp="cp -i"
# alias ln="ln -i"
# alias mv="mv -i"
# alias rm="rm -i"

# pagers
alias less="less --quit-at-eof --no-init --tabs=4 --RAW-CONTROL-CHARS"
alias more="less"

# grep
alias grep="grep --color=auto"
alias egrep="grep -E --color=auto"
alias fgrep="grep -F --color=auto"
alias rg="rg --smart-case --color=auto"

# cat
if command -v bat &>/dev/null; then
    alias cat='bat --paging=never --plain'
fi

# neovide
alias nv="nohup neovide &"

# open
alias o="open"

# clipboard
# macOS has pbcopy/pbpaste built in; Linux needs a helper.
if [[ "$(uname -s)" != "Darwin" ]]; then
  if command -v wl-copy &>/dev/null; then # Wayland
    alias pbcopy="wl-copy"
    alias pbpaste="wl-paste --no-newline"
  elif command -v xclip &>/dev/null; then # X11
    alias pbcopy="xclip -selection clipboard"
    alias pbpaste="xclip -selection clipboard -o"
  elif command -v xsel &>/dev/null; then # X11 fallback
    alias pbcopy="xsel --clipboard --input"
    alias pbpaste="xsel --clipboard --output"
  fi
fi

# python
alias python="python3"

# git
[[ -f ~/.gitaliases ]] && source ~/.gitaliases
